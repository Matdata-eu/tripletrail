# Network profile: ERA RINF micro topology -> pgRouting edge set, trains may reverse.
#
# Builds an edge-based graph so switch navigability is respected: a vertex is
# "<net element>#fwd" or "<net element>#bwd" (the element travelled from its origin to its end,
# or the reverse), and an edge is a move through a navigable era:NetRelation into the next
# element, costing that element's era:lengthOfNetLinearElement (metres). Relations with
# navigability None produce no edge, so a train can never go from one diverging leg of a switch
# to the other.
#
# Same as era-micro.rq plus one reversal edge per element: from "<e>#fwd" to "<e>#bwd" (and back),
# meaning the train stops at the element's end, reverses and runs back through it, costing the
# element's length plus a 1 km reversal penalty. Without these edges most pairs of elements in
# real networks are unreachable, because a train cannot change between branches that only meet
# at a junction pointing away from each other.
#
# Use it as the edge sub-select of a pgr SERVICE call, or as the pgr:edgeQuery of a named network.
# To route from element E in either direction, pass both "E#fwd" and "E#bwd" as start_vid.
#
# Property names and navigability concepts match RINF data published with ERA ontology 3.1
# (graph.data.era.europa.eu, repository rinf-plus, checked 2026-10-31).
PREFIX era: <http://data.europa.eu/949/>
PREFIX nav: <http://data.europa.eu/949/concepts/navigabilities/>
SELECT ?id ?source ?target ?cost ?reverse_cost WHERE {
  {
    ?r a era:NetRelation ; era:elementA ?a ; era:elementB ?b ;
       era:isOnOriginOfElementA ?oa ; era:isOnOriginOfElementB ?ob ; era:navigability ?nav .
    FILTER(?nav IN (nav:AB, nav:Both))
    ?b era:lengthOfNetLinearElement ?cost .
    BIND(CONCAT(STR(?a), IF(?oa, "#bwd", "#fwd")) AS ?source)
    BIND(CONCAT(STR(?b), IF(?ob, "#fwd", "#bwd")) AS ?target)
    BIND(CONCAT(STR(?r), "#ab") AS ?id)
  } UNION {
    ?r a era:NetRelation ; era:elementA ?a ; era:elementB ?b ;
       era:isOnOriginOfElementA ?oa ; era:isOnOriginOfElementB ?ob ; era:navigability ?nav .
    FILTER(?nav IN (nav:BA, nav:Both))
    ?a era:lengthOfNetLinearElement ?cost .
    BIND(CONCAT(STR(?b), IF(?ob, "#bwd", "#fwd")) AS ?source)
    BIND(CONCAT(STR(?a), IF(?oa, "#fwd", "#bwd")) AS ?target)
    BIND(CONCAT(STR(?r), "#ba") AS ?id)
  } UNION {
    ?e a era:LinearElement ; era:lengthOfNetLinearElement ?l .
    BIND(CONCAT(STR(?e), "#fwd") AS ?source)
    BIND(CONCAT(STR(?e), "#bwd") AS ?target)
    BIND(CONCAT(STR(?e), "#reverse") AS ?id)
    BIND(?l + 1000 AS ?cost)
    BIND(?cost AS ?reverse_cost)
  }
}
